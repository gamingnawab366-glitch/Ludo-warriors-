name: Build Ludo Warriors Android APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Godot
        uses: chickensoft-games/setup-godot@v1
        with:
          version: 4.3.0
          use-dotnet: false

      - name: Build APK
        run: |
          mkdir -p build
          godot --headless --path . --export-debug "Android" build/LudoWarriors.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Ludo-Warriors-APK
          path: build/LudoWarriors.apk
